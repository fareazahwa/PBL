<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agrim_bg_cream"
    android:orientation="vertical">

    <!-- 1. Top App Bar (Agrim Admin OPS) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/agrim_bg_cream"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agrim Admin"
                    android:textColor="@color/agrim_text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_wa"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="OPS"
                    android:textColor="@color/agrim_mint_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jelajah"
                android:textColor="@color/agrim_text_body"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Icons -->
        <TextView
            android:id="@+id/btnAdminSearchTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAdminNotifTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="🔔"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAdminProfileTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_pill_dark"
            android:gravity="center"
            android:text="👤"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Title & Tambah Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kelola Pemasok"
                        android:textColor="@color/agrim_text_dark"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kontak PIC &amp; kapasitas terverifikasi"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnTambahPemasok"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/agrim_dark_green"
                    android:paddingHorizontal="14dp"
                    android:text="+ Tambah"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Search Bar & Filter Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔍"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etSearchSupplier"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="Cari pemasok, komoditas, nomor WA..."
                        android:textColor="@color/agrim_text_black"
                        android:textColorHint="@color/agrim_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnTuneFilter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="⚙️"
                    android:textColor="@color/agrim_dark_green" />
            </LinearLayout>

            <!-- Category Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Semua (48)"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Rempah"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Kelapa"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Kopi &amp; Kakao"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Priority Counter & Sort -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3 Pemasok Prioritas"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urutkan ⇅"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD 1: Agrim PTE Ltd -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical">

                <!-- Image Banner Header -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="144dp"
                    android:background="@color/agrim_emerald">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:background="#CC0D2821"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agrim PTE Ltd"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Singapura • Pabrik Surabaya"
