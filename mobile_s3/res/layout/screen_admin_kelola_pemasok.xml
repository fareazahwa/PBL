                            android:background="@drawable/bg_badge_amber"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="⏳ Menunggu Audit"
                            android:textColor="@color/agrim_badge_amber_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- Spec Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spec_strip"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOQ"
                            android:textColor="@color/agrim_text_body"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 MT Pallet"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="12sp"
