<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════
         1. TOP APP BAR (Namabiz + Bookmark)
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Namabiz"
            android:textColor="#18221B"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBookmarkFilter"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="🔖"
            android:textColor="#18221B"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         2. SEARCH BAR & FILTER CHIPS (White Container)
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="14dp">

        <!-- Search Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_buyer_outline"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textColor="#6B7280"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSearchKomoditas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Cari komoditas, asal negara..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="#18221B"
                android:textColorHint="#9CA3AF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Horizontal Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1: Semua Rempah (48) - ACTIVE -->
                <TextView
                    android:id="@+id/chipFilterSemua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_pill_dark"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Semua Rempah (48)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Chip 2: Lampung -->
                <TextView
                    android:id="@+id/chipFilterLampung"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_pill_white"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Lampung"
                    android:textColor="#18221B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Chip 3: Direct Farm -->
                <TextView
                    android:id="@+id/chipFilterDirectFarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_pill_white"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Direct Farm"
                    android:textColor="#18221B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Chip 4: Kopi & Kakao -->
                <TextView
                    android:id="@+id/chipFilterKopi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_pill_white"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="Kopi &amp; Kakao"
                    android:textColor="#18221B"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

