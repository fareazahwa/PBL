<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agrim_bg_cream"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════
         1. TOP APP BAR (Agrim Admin OPS)
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Agrim Admin"
                    android:textColor="@color/agrim_text_dark"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="OPS"
                    android:textColor="@color/agrim_mint_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Jelajah"
                android:textColor="@color/agrim_text_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Right Action Icons: Search, Notif, Profile -->
        <TextView
            android:id="@+id/btnAdminSearchTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="🔍"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAdminNotifTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="🔔"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnAdminProfileTop"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_dark"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="👤"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         2. HEADER: Title + Tombol "+ Tambah"
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kelola Pemasok"
                android:textColor="@color/agrim_text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Kontak PIC &amp; kapasitas terverifikasi"
                android:textColor="@color/agrim_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Button + Tambah -->
        <FrameLayout
            android:id="@+id/btnTambahPemasok"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_button_dark"
            android:foreground="?android:attr/selectableItemBackground"
            android:paddingHorizontal="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+ Tambah"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         3. SEARCH BAR & FILTER BUTTON
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSearchSupplier"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Cari pemasok, komoditas, atau nomor W..."
                android:textColor="@color/agrim_text_black"
                android:textColorHint="@color/agrim_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnFilterSetting"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_input_box"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⚙️"
                android:textSize="16sp" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         4. CATEGORY FILTER CHIPS (Horizontal Scroll)
         ═══════════════════════════════════════════════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Chip 1: Semua (48) - Active Dark Green -->
            <FrameLayout
                android:id="@+id/chipSemua"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_dark"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Semua (48)"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Chip 2: Rempah -->
            <FrameLayout
                android:id="@+id/chipRempah"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_white"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Rempah"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Chip 3: Kelapa -->
            <FrameLayout
                android:id="@+id/chipKelapa"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_pill_white"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Kelapa"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="12sp" />
            </FrameLayout>

            <!-- Chip 4: Kopi & Kakao -->
            <FrameLayout
                android:id="@+id/chipKopiKakao"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_white"
                android:foreground="?android:attr/selectableItemBackground"
                android:paddingHorizontal="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Kopi &amp; Kakao"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ═══════════════════════════════════════════════════
         5. SECTION HEADER: "3 Pemasok Prioritas" + Urutkan
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="3 Pemasok Prioritas"
            android:textColor="@color/agrim_text_black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvUrutkan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:foreground="?android:attr/selectableItemBackground"
            android:text="Urutkan ˅"
            android:textColor="@color/agrim_text_body"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         6. SCROLLABLE SUPPLIER CARDS
         ═══════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- ───────────────────────────────────────────
                 CARD 1: Agrim PTE Ltd
                 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical">

                <!-- Hero Image with Overlaid Content -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="@color/agrim_emerald">

                    <!-- Photo from Glide or Fallback -->
                    <ImageView
                        android:id="@+id/ivHeroPemasok1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <!-- Gradient Shadow for Text Readability -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_image_bottom_dark" />

                    <!-- Overlay Bottom Row: Name & Badges -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agrim PTE Ltd"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Singapura • Pabrik Surabaya"
                                android:textColor="#E0FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Bookmark Icon -->
                        <TextView
                            android:id="@+id/btnBookmark1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:text="🔖"
                            android:textSize="14sp" />

                        <!-- Terverifikasi Badge -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_badge_verified"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="✓ Terverifikasi"
                            android:textColor="@color/agrim_badge_green_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Spec Strip: MOQ & Capacity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spec_strip"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOQ"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 × 20ft FCL"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/agrim_border" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KAPASITAS"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="500 MT/bln"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PIC Info & Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill_dark"
                        android:gravity="center"
                        android:text="👤"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hendrik Gunawan"
                            android:textColor="@color/agrim_text_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+62 812-8990-1234"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Button Ubah -->
                    <FrameLayout
                        android:id="@+id/btnUbah1"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_gray"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✎ Ubah"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <!-- Button Chat WA -->
                    <FrameLayout
                        android:id="@+id/btnChatWA1"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_wa"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="💬 Chat WA"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ───────────────────────────────────────────
                 CARD 2: PT Nusantara Agro
                 ─────────────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_white"
                android:elevation="2dp"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:background="#2E5544">

                    <ImageView
                        android:id="@+id/ivHeroPemasok2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_image_bottom_dark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PT Nusantara Agro"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Jakarta • Pabrik Riau"
                                android:textColor="#E0FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btnBookmark2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom"
                            android:layout_marginEnd="6dp"
                            android:gravity="center"
                            android:text="🔖"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_badge_verified"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="✓ Terverifikasi"
                            android:textColor="@color/agrim_badge_green_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_spec_strip"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MOQ"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 MT LCL"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/agrim_border" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="KAPASITAS"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="350 MT/bln"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pill_dark"
                        android:gravity="center"
                        android:text="👤"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Siti Rahmawati"
                            android:textColor="@color/agrim_text_dark"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+62 819-0887-6123"
                            android:textColor="@color/agrim_text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/btnUbah2"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_button_gray"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="✎ Ubah"
                            android:textColor="@color/agrim_text_black"
                            android:textSize="11sp" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnChatWA2"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_wa"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:paddingHorizontal="12dp">

                        <TextView
                            android:layout_width="wrap_content"
