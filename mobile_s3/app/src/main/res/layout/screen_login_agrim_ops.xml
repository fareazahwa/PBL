<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agrim_bg_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="24dp">

        <!-- 1. Node Info & SSL Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_mint"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_pill_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.04"
                    android:text="BOURSE NODE: JKT-01"
                    android:textColor="@color/agrim_text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 SSL v3 TLS-1.3"
                android:textColor="@color/agrim_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 2. Brand Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Agrim OPS"
            android:textColor="@color/agrim_text_dark"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Portal Manajemen Sesi &amp; Direktori Komoditas Terverifikasi"
            android:textColor="@color/agrim_text_body"
            android:textSize="13sp" />

        <!-- 3. Dual Mode Toggle (Admin Ops vs Buyer) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_segment_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnModeAdmin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Mode Admin (Ops)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModeBuyer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:text="Mode Pengguna (Buyer)"
                android:textColor="@color/agrim_text_body"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4. Login Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_white"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LINGKUP SESI KERJA"
                android:textColor="@color/agrim_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Scope Choice Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipScope1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Operasional"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/chipScope2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Auditor Mutu"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/chipScope3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_white"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Super Admin"
                        android:textColor="@color/agrim_text_body"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Email Field -->
            <TextView
                android:id="@+id/tvEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Email Staf Operasional"
                android:textColor="@color/agrim_text_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:hint="ops.jkt@agrim.id"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="12dp"
                android:textColor="@color/agrim_text_black"
                android:textColorHint="@color/agrim_text_secondary"
                android:textSize="13sp" />

            <!-- Password Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi Utama"
                    android:textColor="@color/agrim_text_black"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lupa sandi?"
                    android:textColor="@color/agrim_emerald"
                    android:textSize="12sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_box"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/agrim_text_black"
                android:textColorHint="@color/agrim_text_secondary"
                android:textSize="13sp" />

            <!-- Remember & AES-256 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRemember"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Ingat sesi (30 hari)"
                    android:textColor="@color/agrim_text_body"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_mint"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="🛡️ AES-256"
                    android:textColor="@color/agrim_text_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Submit Button -->
            <Button
                android:id="@+id/btnLoginSubmit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/agrim_emerald"
                android:text="Masuk ke Sesi Admin (Operasional)"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- SSO Button -->
            <Button
                android:id="@+id/btnLoginSSO"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/agrim_strip_gray"
                android:text="Masuk dengan SSO Korporat"
                android:textAllCaps="false"
                android:textColor="@color/agrim_text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 5. Node Notice Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ OTORISASI NODE OPERASIONAL (JKT-01)"
                android:textColor="@color/agrim_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Seluruh aktivitas staf terekam dalam log audit bursa Agrim. Hubungi IT Helpdesk untuk delegasi wewenang verifikasi."
                android:textColor="@color/agrim_text_body"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

