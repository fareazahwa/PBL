                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Head of Operations &amp; WhatsApp Hub"
                            android:textColor="@color/agrim_text_body"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_badge_verified"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="✓ Super Admin Terverifikasi"
                            android:textColor="@color/agrim_badge_green_text"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/agrim_strip_gray" />

                <LinearLayout
