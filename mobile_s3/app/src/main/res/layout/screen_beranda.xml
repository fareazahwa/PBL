<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5F0"
    android:orientation="vertical">

    <!-- ═══════════════════════════════════════════════════
         1. TOP HEADER (Avatar, Greeting & Actions)
         ═══════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F5F0"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Avatar Round Card (Joko Tole) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardBuyerAvatarBeranda"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#E0E6E2">

            <ImageView
                android:id="@+id/ivBuyerAvatarBeranda"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher_round" />
        </androidx.cardview.widget.CardView>

        <!-- Greeting Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat pagi,"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuyerNameBeranda"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joko Tole"
                android:textColor="#18221B"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Button: Notifikasi (Bell with dot) -->
        <FrameLayout
            android:id="@+id/btnBuyerNotifBeranda"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_square_icon_btn"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔔"
                android:textSize="16sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_avatar"
                android:backgroundTint="#F59E0B" />
        </FrameLayout>

        <!-- Action Button: QR Scanner -->
        <FrameLayout
            android:id="@+id/btnBuyerQrScannerBeranda"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_square_icon_btn"
            android:foreground="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="⛶"
                android:textColor="#18221B"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════
         2. SCROLLABLE BODY
         ═══════════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- 2.1 Membership Status Card -->
            <LinearLayout
                android:id="@+id/cardBuyerMembershipBeranda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card_buyer_outline"
                android:elevation="0dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <!-- Green dot -->
                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_circle_avatar"
                    android:backgroundTint="#1E513A" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Business Pro"
                    android:textColor="#18221B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="· diperpanjang 14 Des 2026"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnKelolaMembershipBeranda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="Kelola"
                    android:textColor="#18221B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 
                BAGIAN "! Perlu perhatian" TELAH DIHILANGKAN SESUAI INSTRUKSI PENGGUNA.
            -->

            <!-- 2.2 Tombol Aksi Utama: RFQ Baru -->
            <LinearLayout
                android:id="@+id/btnRfqBaruBeranda"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_rfq_dark"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⊕"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="RFQ Baru"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2.3 Quick Metrics Summary Strip -->
            <LinearLayout
                android:id="@+id/btnBuyerMetricsStripBeranda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card_buyer_outline"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <!-- 12 disimpan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#18221B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="disimpan"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="·"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <!-- 2 dibandingkan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#18221B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="dibandingkan"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:text="·"
                    android:textColor="#9CA3AF"
                    android:textSize="13sp" />

                <!-- 18 katalog diunduh -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:textColor="#18221B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="katalog diunduh"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <!-- Arrow right -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="→"
                    android:textColor="#6B7280"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 2.4 Section Header: Baru Dilihat -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Baru dilihat"
                    android:textColor="#18221B"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLihatKatalogBeranda"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="Lihat katalog"
                    android:textColor="#1E513A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2.5 Horizontal Scroll: Kartu Pemasok Baru Dilihat -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="4dp">

                    <!-- ═══════════════════════════════════════════
                         KARTU 1: Agrim PTE Ltd
                         ═══════════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBuyerSupplier1Beranda"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E4DDCF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_buyer_outline"
                            android:orientation="vertical">

                            <!-- Top Image Container + Floating Badge -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="140dp">

                                <ImageView
                                    android:id="@+id/ivBuyerCard1Beranda"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bg_spec_strip" />

                                <!-- Location Badge (Vietnam · Dataran Tinggi) -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="10dp"
                                    android:background="@drawable/bg_pill_floating_white"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:text="Vietnam · Dataran Tinggi"
                                    android:textColor="#18221B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <!-- Card Body -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Agrim PTE Ltd"
                                    android:textColor="#18221B"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audit Info -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_circle_avatar"
                                        android:backgroundTint="#1E513A"
                                        android:gravity="center"
                                        android:text="✓"
                                        android:textColor="#FFFFFF"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Diaudit di lokasi, Okt 2025"
                                        android:textColor="#1E513A"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Divider -->
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginVertical="10dp"
                                    android:background="#EAE6DC" />

                                <!-- Specs Grid (MOQ & Waktu Tunggu) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="MOQ"
                                            android:textColor="#9CA3AF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="1 × 20ft FCL"
                                            android:textColor="#18221B"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="WAKTU TUNGGU"
                                            android:textColor="#9CA3AF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="14 hari"
                                            android:textColor="#18221B"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════════
                         KARTU 2: Nusantara Agro
                         ═══════════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBuyerSupplier2Beranda"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E4DDCF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_buyer_outline"
                            android:orientation="vertical">

                            <!-- Top Image Container + Floating Badge -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="140dp">

                                <ImageView
                                    android:id="@+id/ivBuyerCard2Beranda"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bg_spec_strip" />

                                <!-- Location Badge (Indonesia · Sumatera) -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="10dp"
                                    android:background="@drawable/bg_pill_floating_white"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:text="Indonesia · Sumatera"
                                    android:textColor="#18221B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <!-- Card Body -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nusantara Agro"
                                    android:textColor="#18221B"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audit Info -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_circle_avatar"
                                        android:backgroundTint="#1E513A"
                                        android:gravity="center"
                                        android:text="✓"
                                        android:textColor="#FFFFFF"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Diaudit di lokasi, Sep 2025"
                                        android:textColor="#1E513A"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Divider -->
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginVertical="10dp"
                                    android:background="#EAE6DC" />

                                <!-- Specs Grid (MOQ & Waktu Tunggu) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="MOQ"
                                            android:textColor="#9CA3AF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="5 MT"
                                            android:textColor="#18221B"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:orientation="vertical">

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="WAKTU TUNGGU"
                                            android:textColor="#9CA3AF"
                                            android:textSize="10sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:text="7 hari"
                                            android:textColor="#18221B"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>
                                </LinearLayout>

                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ═══════════════════════════════════════════
                         KARTU 3: Ceylon Harvest
                         ═══════════════════════════════════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardBuyerSupplier3Beranda"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="14dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#E4DDCF"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_card_buyer_outline"
                            android:orientation="vertical">

                            <!-- Top Image Container + Floating Badge -->
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="140dp">

                                <ImageView
                                    android:id="@+id/ivBuyerCard3Beranda"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/bg_spec_strip" />

                                <!-- Location Badge (Indonesia · Jawa Barat) -->
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="top|start"
                                    android:layout_margin="10dp"
                                    android:background="@drawable/bg_pill_floating_white"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="4dp"
                                    android:text="Indonesia · Jawa Barat"
                                    android:textColor="#18221B"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <!-- Card Body -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ceylon Harvest"
                                    android:textColor="#18221B"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <!-- Audit Info -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:background="@drawable/bg_circle_avatar"
                                        android:backgroundTint="#1E513A"
                                        android:gravity="center"
                                        android:text="✓"
                                        android:textColor="#FFFFFF"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:text="Diaudit di lokasi, Nov 2025"
                                        android:textColor="#1E513A"
                                        android:textSize="11sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <!-- Divider -->
                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:layout_marginVertical="10dp"
                                    android:background="#EAE6DC" />

                                <!-- Specs Grid (MOQ & Waktu Tunggu) -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <LinearLayout
                                        android:layout_width="0dp"
