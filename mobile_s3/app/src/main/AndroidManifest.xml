<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Mobile_s3">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mobile_s3"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BerandaDirektoriAgrim"
            android:exported="false"
            android:label="Beranda Direktori Agrim"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".FilterUrutkanActivity"
            android:exported="false"
            android:label="Filter dan Urutkan"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".AdminKelolaPemasokWhatsApp"
            android:exported="false"
            android:label="Admin Kelola Pemasok WhatsApp"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".AdminKelolaMatriksBandingkan"
            android:exported="false"
            android:label="Admin Kelola Matriks Bandingkan"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".AdminKelolaStafPengguna"
            android:exported="false"
            android:label="Admin Kelola Staf Pengguna"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".BandingkanBuyerActivity"
            android:exported="false"
            android:label="Bandingkan Pemasok Buyer"
            android:theme="@style/Theme.Mobile_s3" />

        <activity
            android:name=".AkunBuyerActivity"
            android:exported="false"
            android:label="Akun Buyer"
            android:theme="@style/Theme.Mobile_s3" />
    </application>

</manifest>